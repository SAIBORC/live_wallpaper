[package]
name = "live-wallpaper"
version = "0.1.1"
edition = "2021"
description = "Lightweight MP4 video live wallpaper for macOS"
license = "MIT"
authors = ["SAIBORC"]

[dependencies]
cocoa = "0.24"
core-graphics = "0.23"
libloading = "0.8"
serde = { version = "1", features = ["derive"] }
serde_json = "1"

[profile.release]
opt-level = 3
lto = true
strip = true
panic = "abort"