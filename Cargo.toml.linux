[package]
name = "live-wallpaper"
version = "0.1.1"
edition = "2021"
description = "Lightweight MP4 video live wallpaper for Linux"
license = "MIT"
authors = ["SAIBORC"]

[dependencies]
x11rb = "0.9"
ayatana-appindicator3 = { version = "0.6", default-features = false, features = ["gtk4"] }
gtk4 = "0.6"
libc = "0.2"
libloading = "0.8"
serde = { version = "1", features = ["derive"] }
serde_json = "1"

[profile.release]
opt-level = 3
lto = true
strip = true
panic = "abort"